# SpeakLoop needs one model provider. Copy this file to .env and fill in a key.
#
# OpenAI is preferred for quality and is the only provider for speech in/out.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini is the fallback. Its free tier needs no payment card
# (https://aistudio.google.com/apikey) and covers 1,500 requests a day, so
# coaching and vocabulary cards keep working when OpenAI has no credit.
GEMINI_API_KEY=

HOST=0.0.0.0
PORT=4173

# Live coaching and sentence repair.
OPENAI_TEXT_MODEL_STRONG=gpt-5.5
OPENAI_TEXT_MODEL_MID=gpt-5.5
OPENAI_REALTIME_MODEL=gpt-5.5

# Cheaper batch work: vocabulary cards, next-day review, weekly report.
OPENAI_TEXT_MODEL_MINI=gpt-5.4-mini

# Speech in and out. OpenAI only — with a Gemini-only setup the microphone and
# read-aloud are unavailable, and the app says so instead of failing silently.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Gemini models used when it serves.
GEMINI_TEXT_MODEL_STRONG=gemini-2.5-flash
GEMINI_TEXT_MODEL_MID=gemini-2.5-flash
GEMINI_TEXT_MODEL_MINI=gemini-2.5-flash-lite

ENABLE_AUDIO_CACHE=true
ENABLE_COST_TRACKING=true
