# SpeakLoop runs on OpenAI only. Copy this file to .env and add your key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

HOST=0.0.0.0
PORT=4173

# Live coaching and sentence repair.
OPENAI_TEXT_MODEL_STRONG=gpt-5.5
OPENAI_TEXT_MODEL_MID=gpt-5.5
OPENAI_REALTIME_MODEL=gpt-5.5

# Cheaper batch work: vocabulary cards, next-day review, weekly report.
OPENAI_TEXT_MODEL_MINI=gpt-5.4-mini

# Speech in and out.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts

ENABLE_AUDIO_CACHE=true
ENABLE_COST_TRACKING=true

# Off by default: when true, an OpenAI outage serves a canned demo reply
# instead of surfacing the error. Leave false so failures stay visible.
ENABLE_MODEL_FALLBACK=false
