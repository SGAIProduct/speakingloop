OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
HOST=0.0.0.0
PORT=4173

DEFAULT_REALTIME_PROVIDER=openai
DEFAULT_ASR_PROVIDER=openai
DEFAULT_TEXT_PROVIDER=openai
DEFAULT_REPORT_PROVIDER=qwen
DEFAULT_REVIEW_PROVIDER=qwen
DEFAULT_VOCAB_PROVIDER=qwen
DEFAULT_TTS_PROVIDER=openai

OPENAI_REALTIME_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_TEXT_MODEL_STRONG=gpt-5.5
OPENAI_TEXT_MODEL_MID=gpt-5.4-mini
OPENAI_TEXT_MODEL_MINI=gpt-5.4-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts

ENABLE_QWEN=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
QWEN_TEXT_MODEL_STANDARD=qwen3:8b
QWEN_TEXT_MODEL_CHEAP=qwen3:8b
ENABLE_GEMINI=false
QWEN_AS_FALLBACK=false
GEMINI_AS_FALLBACK=false
ENABLE_MODEL_FALLBACK=false
ENABLE_AUDIO_CACHE=true
ENABLE_COST_TRACKING=true
