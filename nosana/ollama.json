{
  "version": "0.1",
  "type": "container",
  "ops": [
    {
      "type": "container/run",
      "id": "speakloop-review-model",
      "args": {
        "image": "docker.io/ollama/ollama:0.32.6",
        "entrypoint": ["/bin/sh"],
        "cmd": [
          "-c",
          "ollama serve & sleep 5 && ollama pull $MODEL && wait"
        ],
        "env": {
          "MODEL": "qwen3:8b"
        },
        "gpu": true,
        "expose": 11434
      }
    }
  ]
}
